{
  "name": "@desktop-helper/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "桌宠桌面应用壳（Electron ≥ v42）",
  "author": "desktop-helper",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/generate-icons.js && electron-vite dev",
    "build": "node ../../scripts/generate-icons.js && electron-vite build",
    "start": "electron-vite preview",
    "dist": "node ../../scripts/generate-icons.js && electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "publish": {
    "provider": "github"
  },
  "dependencies": {
    "@desktop-helper/core": "*",
    "@desktop-helper/platform-api": "*",
    "@pixi/unsafe-eval": "^6.5.10",
    "edge-tts": "^1.0.1",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "42.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.2.0"
  }
}
